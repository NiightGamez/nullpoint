pkgname=nullpoint-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Zero-server, encrypted P2P communication client powered by embedded Tor v3 (Arti) and Argon2id"
arch=('x86_64')
url="https://github.com/NiightGamez/discord-p2p"
license=('AGPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'openssl' 'dbus')
provides=('nullpoint')
conflicts=('nullpoint')
options=('!strip')
source=("${pkgname}-${pkgver}.deb::https://github.com/NiightGamez/nullpoint/releases/download/v0.2.0/NullPoint_0.2.0_amd64.deb")
sha256sums=('b47c250a9b4e39f0467d1609b5663593d9d59561e70a59d462bae8c0a6cac78a')

package() {
    bsdtar -xf "${srcdir}/data.tar."* -C "${pkgdir}/"
    chmod 755 "${pkgdir}/usr/bin/nullpoint"
}
